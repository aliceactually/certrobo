{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CertRobo": {
    "DataDirectory": "App_Data",
    "CaPassphraseEnv": "CERTROBO_CA_PASSPHRASE",
    "PublicBaseUrl": "",
    "CrlValidityHours": 168,
    "ReverseProxy": {
      "KnownProxies": [ "127.0.0.1", "::1" ],
      "KnownNetworks": [],
      "ForwardLimit": 1
    },
    "Oidc": {
      "Enabled": false,
      "DisplayName": "OpenID Connect",
      "DefaultLoginMode": "Local",
      "Issuer": "",
      "Authority": "",
      "ClientId": "",
      "ClientSecretEnv": "CERTROBO_OIDC_CLIENT_SECRET",
      "ClientSecretFile": "",
      "PublicCallbackUrl": "",
      "SignedOutCallbackPath": "/signout-callback-oidc",
      "EnableIdpSignOut": false,
      "GetClaimsFromUserInfoEndpoint": false,
      "GroupClaimType": "groups",
      "SubjectClaimType": "sub",
      "PreferredUsernameClaimType": "preferred_username",
      "EmailClaimType": "email",
      "DisplayNameClaimType": "name",
      "Scopes": [ "openid", "profile", "email" ],
      "MaxSessionLifetimeMinutes": 60,
      "SessionRevalidationSeconds": 10,
      "GroupMappings": []
    }
  }
}
