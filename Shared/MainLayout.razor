@inherits LayoutComponentBase
@implements IDisposable
@using CertRobo.Data
@inject CertRobo.Shared.ThemeService ThemeService

<PageTitle>CertRobo</PageTitle>
<RadzenNotification />

<div class="page">

    <main>
        <table class="top-row auth">
            <tr>
                <td class="auth-cell">
                    <AuthorizeView>
                        <Authorized>
                            <span>Hello @context.User.Identity?.Name</span>
                            <a href="/" class="ms-3">Certificate Tool</a>
                            @if (context.User.IsInRole(AppRoles.Administrator))
                            {
                                <a href="/admin" class="ms-3">Administration</a>
                            }
                            <a href="/ca.crt" class="ms-3" target="_blank">CA Chain</a>
                            <a href="/ca.crl" class="ms-3" target="_blank">CRL</a>
                            <form method="post" action="/account/logout" style="display:inline" class="ms-3">
                                <input type="hidden" name="__RequestVerificationToken" value="@AntiforgeryToken" />
                                <button type="submit" class="btn btn-link p-0">Sign Out</button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            @if (IsBootstrapRequired)
                            {
                                <a href="/setup" target="_top">Initial Setup</a>
                            }
                            else
                            {
                                <a href="/login" target="_top">Sign In</a>
                            }
                        </NotAuthorized>
                    </AuthorizeView>
                </td>
                <td class="toggle-cell">
                    @if (_initialized)
                    {
                        <button class="theme-toggle" @onclick="ToggleTheme" title="Toggle dark mode">
                            <span class="theme-icon">@(ThemeService.CurrentTheme == "dark" ? "☀️" : "🌙")</span>
                        </button>
                    }
                </td>
            </tr>
        </table>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _initialized;

    [CascadingParameter(Name = "AntiforgeryToken")]
    public string? AntiforgeryToken { get; set; }

    [CascadingParameter(Name = "IsBootstrapRequired")]
    public bool IsBootstrapRequired { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeThemeAsync();
            ThemeService.OnThemeChanged += StateHasChanged;
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        if (_initialized)
        {
            await ThemeService.ToggleThemeAsync();
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}
