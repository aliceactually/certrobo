@inherits LayoutComponentBase
@implements IDisposable
@using CertRobo.Data
@inject CertRobo.Shared.ThemeService ThemeService
@inject NavigationManager NavigationManager

<PageTitle>CertRobo</PageTitle>
<RadzenNotification />

<div class="page">
    <main>
        <header class="top-row" role="banner">
            <div class="top-row-left">
                <a href="/" class="brand-title">CertRobo</a>
                <AuthorizeView>
                    <Authorized>
                        <nav class="primary-nav" aria-label="Main navigation">
                            <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All">
                                Certificate Tool
                            </NavLink>
                            @if (context.User.IsInRole(AppRoles.Administrator))
                            {
                                <NavLink class="nav-item-link" href="admin">
                                    Administration
                                </NavLink>
                            }
                        </nav>
                        <div class="trust-links" role="group" aria-label="Public CA downloads">
                            <a href="/ca.crt" class="trust-link" target="_blank" title="Download active CA certificate chain (PEM)">CA Chain</a>
                            <a href="/ca.crl" class="trust-link" target="_blank" title="Download latest Certificate Revocation List (DER)">CRL</a>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="top-row-right">
                <AuthorizeView>
                    <Authorized>
                        <span class="user-greeting" title="Signed-in local account">
                            Signed in as <strong>@context.User.Identity?.Name</strong>
                        </span>
                        <form method="post" action="/account/logout" class="logout-form">
                            <input type="hidden" name="__RequestVerificationToken" value="@AntiforgeryToken" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary logout-btn">Sign Out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        @if (IsBootstrapRequired)
                        {
                            <a href="/setup" target="_top" class="btn btn-sm btn-primary">Initial Setup</a>
                        }
                        else
                        {
                            <a href="/login" target="_top" class="btn btn-sm btn-primary">Sign In</a>
                        }
                    </NotAuthorized>
                </AuthorizeView>

                @if (_initialized)
                {
                    <button type="button"
                            class="theme-toggle"
                            @onclick="ToggleTheme"
                            aria-label="@(ThemeService.CurrentTheme == "dark" ? "Switch to light theme" : "Switch to dark theme")"
                            title="@(ThemeService.CurrentTheme == "dark" ? "Switch to light theme" : "Switch to dark theme")">
                        <span class="theme-icon" aria-hidden="true">@(ThemeService.CurrentTheme == "dark" ? "☀️" : "🌙")</span>
                    </button>
                }
            </div>
        </header>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _initialized;

    [CascadingParameter(Name = "AntiforgeryToken")]
    public string? AntiforgeryToken { get; set; }

    [CascadingParameter(Name = "IsBootstrapRequired")]
    public bool IsBootstrapRequired { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeThemeAsync();
            ThemeService.OnThemeChanged += StateHasChanged;
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        if (_initialized)
        {
            await ThemeService.ToggleThemeAsync();
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}
