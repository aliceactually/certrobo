    private async Task ExportIssuedCertificateBundleClick(IssuedCertificateRecord record)
    {
        try
        {
            string? chainPem = !string.IsNullOrWhiteSpace(record.ChainPem)
                ? record.ChainPem
                : await CaService.ResolveCertificateChainPemAsync(record.CertificatePem);

            Tuple<string, byte[]>? zipObj = PkcsBuilder.Export(
                record.CertificatePem,
                privateKey: string.Empty,
                rootCaCertPath: null,
                chainPemContent: chainPem);

            if (zipObj == null)
            {
                Notify(Radzen.NotificationSeverity.Error, "Export Error", "Could not build certificate export archive.");
                return;
            }

            MemoryStream output = new(zipObj.Item2);
            using DotNetStreamReference streamRef = new(output, false);
            await JS.InvokeVoidAsync("downloadFileFromStream", zipObj.Item1, streamRef);
            Notify(Radzen.NotificationSeverity.Success, "Certificate Exported", $"Downloaded {zipObj.Item1} with its original issuer chain.");
        }
        catch (Exception ex)
        {
            Notify(Radzen.NotificationSeverity.Error, "Export Error", ex.Message);
        }
    }

