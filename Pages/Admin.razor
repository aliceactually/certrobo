    private async Task SubmitToCesClick(bool forceResubmit)
    {
        if (pendingEnrollment == null || CesService == null)
        {
            return;
        }

        AdCsCesOperationResult result = await CesService.SubmitPendingEnrollmentAsync(
            pendingEnrollment.Id,
            string.IsNullOrWhiteSpace(cesOneTimePassword) ? null : cesOneTimePassword,
            templateOverride: null,
            forceResubmit: forceResubmit);

        cesOneTimePassword = "";
        await ReloadAllAsync();

        var severity = result.OutcomeKind switch
        {
            AdCsCesOutcomeKind.IssuedReadyForActivation => Radzen.NotificationSeverity.Success,
            AdCsCesOutcomeKind.PendingApproval => Radzen.NotificationSeverity.Info,
            AdCsCesOutcomeKind.IssuedAwaitingChainAnchor => Radzen.NotificationSeverity.Warning,
            AdCsCesOutcomeKind.SubmissionUncertain => Radzen.NotificationSeverity.Warning,
            _ => Radzen.NotificationSeverity.Error
        };

        Notify(severity, $"AD CS CES ({result.OutcomeKind})", result.SummaryMessage);
    }

