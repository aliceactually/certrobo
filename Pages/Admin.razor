    private async Task DownloadPendingCsrClick()
    {
        if (pendingEnrollment == null)
        {
            return;
        }

        try
        {
            var csrDownload = await CaService.GetPendingCaCsrForDownloadAsync(pendingEnrollment.Id);
            if (csrDownload == null)
            {
                Notify(Radzen.NotificationSeverity.Error, "Download Error", "Pending CSR was not found.");
                return;
            }

            byte[] csrBytes = System.Text.Encoding.ASCII.GetBytes(csrDownload.Value.CsrPem);
            MemoryStream output = new(csrBytes);
            using DotNetStreamReference streamRef = new(output, false);
            await JS.InvokeVoidAsync("downloadFileFromStream", csrDownload.Value.FileName, streamRef);
        }
        catch (Exception ex)
        {
            Notify(Radzen.NotificationSeverity.Error, "Download Error", ex.Message);
        }
    }

    private async Task OnManualSignedCertFileSelected(InputFileChangeEventArgs e)
