    private async Task ValidateManualBundleClick()
    {
        if (pendingEnrollment == null)
        {
            return;
        }

        try
        {
            CaBundleValidationResult result = await CaService.ValidateAndStageSignedCaBundleAsync(
                pendingEnrollment.Id,
                manualSignedCertFileBytes,
                manualSignedCertText,
                manualChainCertFileBytes,
                manualChainCertText,
                string.IsNullOrWhiteSpace(pendingOperationPassphrase) ? null : pendingOperationPassphrase);

            pendingOperationPassphrase = "";
            await ReloadAllAsync();

            if (!result.IsValid)
            {
                Notify(Radzen.NotificationSeverity.Error, "Validation Failed", result.ErrorMessage ?? "Certificate or chain validation failed.");
                return;
            }

            manualSignedCertFileBytes = null;
            manualChainCertFileBytes = null;
            manualSignedCertText = "";
            manualChainCertText = "";
            Notify(Radzen.NotificationSeverity.Success, "Validation Succeeded", "Signed Issuing CA certificate and chain validated. Review the summary and click 'Activate Issuing CA Now'.");
        }
        catch (Exception ex)
        {
            Notify(Radzen.NotificationSeverity.Error, "Validation Error", ex.Message);
        }
    }

    private async Task ActivatePendingCaClick()
    {
        if (pendingEnrollment == null)
        {
            return;
        }

        try
        {
            bool confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                activeCa == null
                    ? $"Activate Issuing CA '{pendingEnrollment.CaName}' and enable certificate issuance?"
                    : $"Replace active Issuing CA '{activeCa.Name}' with '{pendingEnrollment.CaName}'? The previous CA and its historical records will be retained.");
            if (!confirmed)
            {
                return;
            }

            CaAuthorityRecord activated = await CaService.ActivatePendingCaEnrollmentAsync(
                pendingEnrollment.Id,
                string.IsNullOrWhiteSpace(pendingOperationPassphrase) ? null : pendingOperationPassphrase);

            pendingOperationPassphrase = "";
            caProvisionMode = CaProvisionMode.None;
            await ReloadAllAsync();
            Notify(Radzen.NotificationSeverity.Success, "Issuing CA Activated", $"Activated Issuing CA '{activated.Name}' and published initial CRL #1.");
        }
        catch (Exception ex)
        {
            await ReloadAllAsync();
            Notify(Radzen.NotificationSeverity.Error, "Activation Error", ex.Message);
        }
    }

    private async Task CancelPendingEnrollmentClick()
    {
        if (pendingEnrollment == null)
        {
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Cancel pending request '{pendingEnrollment.CaName}' and permanently delete its unactivated private key?");
        if (!confirmed)
        {
            return;
        }

        var (ok, err) = await CaService.CancelPendingCaEnrollmentAsync(pendingEnrollment.Id);
        if (!ok)
        {
            Notify(Radzen.NotificationSeverity.Error, "Cancel Error", err ?? "Failed to cancel pending request.");
            return;
        }

        manualSignedCertFileBytes = null;
        manualChainCertFileBytes = null;
        manualSignedCertText = "";
        manualChainCertText = "";
        caProvisionMode = activeCa == null ? CaProvisionMode.Create : CaProvisionMode.None;
        await ReloadAllAsync();
        Notify(Radzen.NotificationSeverity.Info, "Pending Request Cancelled", "Cancelled pending external CA request.");
    }

