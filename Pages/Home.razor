@page "/"
@attribute [Authorize]
@using CertRobo.Data
@using CertRobo.Models
@using CertRobo.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using System.Security.Claims
@using System.Text
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccountManagementService AccountService
@inject CertificateAuthorityService CaService
@inject IJSRuntime JS
@inject Radzen.NotificationService NotificationService

<PageTitle>CertRobo</PageTitle>

<div class="container-fluid">
    @if (activeCa == null)
    {
        <div class="row mb-3">
            <div class="col" style="max-width: 1248px;">
                @if (pendingCaEnrollment != null)
                {
                    <div class="alert alert-info" role="status">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                            <h4 class="h5 mb-0">
                                Pending Issuing CA Enrolment: @pendingCaEnrollment.CaName
                                <span class="badge bg-primary ms-2">@FormatPendingStatusLabel(pendingCaEnrollment.Status)</span>
                            </h4>
                            <AuthorizeView Roles="@AppRoles.Administrator">
                                <div class="d-flex flex-wrap gap-2">
                                    <a href="/admin/pending-ca/csr" target="_blank" class="btn btn-sm btn-outline-primary">Download CA CSR (.csr)</a>
                                    <a href="/admin" class="btn btn-sm btn-primary">Complete CA Enrolment in Administration</a>
                                </div>
                            </AuthorizeView>
                        </div>
                        <p class="mb-1 small">
                            Leaf certificate issuance is unavailable until the pending Issuing CA (<code>@pendingCaEnrollment.SubjectDistinguishedName</code>, @pendingCaEnrollment.KeyAlgorithm @pendingCaEnrollment.KeySizeBits) is signed by its parent CA, validated, and activated.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(pendingCaEnrollment.StatusDetailMessage))
                        {
                            <div class="small text-muted-theme">@pendingCaEnrollment.StatusDetailMessage</div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2" role="status">
                        <div>
                            <h4 class="h5 mb-1">Issuing CA Setup Required — Certificate Issuance Unavailable</h4>
                            <p class="mb-0 small">Configure an Issuing CA (generate a self-signed Root CA, import an existing Issuing CA, or request an Issuing CA certificate from an external CA) to enable leaf certificate issuance.</p>
                        </div>
                        <AuthorizeView Roles="@AppRoles.Administrator">
                            <a href="/admin" class="btn btn-sm btn-primary">Configure Issuing CA</a>
                        </AuthorizeView>
                    </div>
                }
            </div>
        </div>
    }
    <div class="row">
        <div class="col" style="width:624px;min-width:624px;max-width:624px">
            <RadzenCard>
                <div class="row" style="margin:0 auto">
                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Private key</RadzenText>
                    <RadzenTextArea Cols="64" Rows="8" MaxLength="8192" Style="font-family:Courier New, Courier, monospace;font-size:small" @bind-Value=@privateKey TValue="string" />
                </div>
                <div class="row" style="height: 6px" />
                <div class="row" style="margin:0 auto">
                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Public key</RadzenText>
                    <RadzenTextArea Cols="64" Rows="8" MaxLength="2048" Style="font-family:Courier New, Courier, monospace;font-size:small" @bind-Value=@publicKey TValue="string" />
                </div>
                <div class="row" style="height: 6px" />
                <div class="row" style="margin:0 auto">
                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Key strength</RadzenText>
                </div>
                <div class="row" style="margin:0 auto">
                    <RadzenRadioButtonList @bind-Value=@keyBits TValue="int?">
                        <Items>
                            <RadzenRadioButtonListItem Text="ECDSA 384" Value="384" TValue="int?" />
                            <RadzenRadioButtonListItem Text="ECDSA 256" Value="256" TValue="int?" />
                            <RadzenRadioButtonListItem Text="RSA 4096" Value="4096" TValue="int?" />
                            <RadzenRadioButtonListItem Text="RSA 2048" Value="2048" TValue="int?" />
                        </Items>
                    </RadzenRadioButtonList>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row" style="margin:0 auto">
                    <div class="col" style="width:50%">
                        <RadzenButton Text="Generate key pair" Style="width:100%" Click="@GenerateClick" />
                    </div>
                    <div class="col" style="width:50%">
                        <RadzenButton Text="Derive public key" Style="width:100%" Click=@DeriveClick />
                    </div>
                </div>
            </RadzenCard>
        </div>
        <div class="col" style="width:624px;min-width:624px;max-width:624px">
            <RadzenCard>
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Common Name</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@commonName TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenButton Text="Autofill remaining" Style="width:100%" Click="@AutofillClick" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Subject Alternative Name(s)</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@subjectAlternativeNames TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Country</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@country TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">State or Province</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@stateOrProvince TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Locality</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@locality TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Organisation</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@organisation TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Organisational Unit</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@organisationalUnit TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:208px;min-width:208px;max-width:208px">
                        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Email Address</RadzenText>
                    </div>
                    <div class="col" style="width:100%">
                        <RadzenTextBox @bind-Value=@emailAddress TValue="string" Class="w-100" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:100%">
                        <RadzenButton Text="Generate Certificate Signing Request" Style="width:100%" Click="@CSRClick" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:100%">
                        <RadzenButton Text="Request certificate from Issuing CA" Style="width:100%" Click="@RequestClick" Disabled="@(activeCa == null)" />
                    </div>
                </div>
                <div class="row" style="height: 6px" />
                <div class="row">
                    <div class="col" style="width:100%">
                        <RadzenButton Text="Export" Style="width:100%" Click="@ExportClick" />
                    </div>
                </div>
            </RadzenCard>
        </div>
    </div>
    <div class="row" style="height: 24px" />
    <div class="row">
        <div class="col" style="width:624px;min-width:624px;max-width:624px">
            <RadzenCard>
                <div class="row" style="margin:0 auto">
                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Certificate Signing Request</RadzenText>
                    <RadzenTextArea Cols="64" Rows="8" MaxLength="4096" Style="font-family:Courier New, Courier, monospace;font-size:small" @bind-Value=@csr TValue="string" />
                </div>
            </RadzenCard>
        </div>
        <div class="col" style="width:624px;min-width:624px;max-width:624px">
            <RadzenCard>
                <div class="row" style="margin:0 auto">
                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Certificate</RadzenText>
                    <RadzenTextArea Cols="64" Rows="8" MaxLength="4096" Style="font-family:Courier New, Courier, monospace;font-size:small" @bind-Value=@certificate TValue="string" />
                </div>
            </RadzenCard>
        </div>
    </div>
</div>

@code {
    private readonly CryptoFactory crypto = new();
    private int? keyBits = null;
    private string privateKey = "";
    private string publicKey = "";
    private string commonName = "";
    private string country = "";
    private string stateOrProvince = "";
    private string locality = "";
    private string organisation = "";
    private string organisationalUnit = "";
    private string emailAddress = "";
    private string subjectAlternativeNames = "";
    private string csr = "";
    private string certificate = "";
    private string? lastIssuedChainPem = null;
    private CaAuthorityRecord? activeCa;
    private PendingCaEnrollmentRecord? pendingCaEnrollment;

    protected override async Task OnInitializedAsync()
    {
        activeCa = await CaService.GetActiveAuthorityAsync();
        pendingCaEnrollment = await CaService.GetActivePendingEnrollmentAsync();
    }

    private static string FormatPendingStatusLabel(PendingCaEnrollmentStatus status) => status switch
    {
        PendingCaEnrollmentStatus.AwaitingSubmission => "Awaiting Submission",
        PendingCaEnrollmentStatus.SubmissionUncertain => "Submission Outcome Uncertain",
        PendingCaEnrollmentStatus.AwaitingApproval => "Awaiting Parent CA Approval",
        PendingCaEnrollmentStatus.ReadyForActivation => "Ready for Activation",
        PendingCaEnrollmentStatus.Failed => "Attention Required",
        _ => status.ToString()
    };

    private void ShowErrorDialogue(string message)
    {
        NotificationService.Notify(new Radzen.NotificationMessage
        {
            Severity = Radzen.NotificationSeverity.Error,
            Summary = "Error",
            Detail = message,
            Duration = 5000,
            Style = "position: fixed; left: 50%; transform: translateX(-50%); width: auto; max-width: 600px; z-index: 9999;"
        });
    }

    private async Task GenerateClick()
    {
        if (!keyBits.HasValue)
        {
            ShowErrorDialogue("You must select key strength before generating a key pair");
            return;
        }

        using CancellationTokenSource cts = new();
        Task animationTask = Task.Run(async () =>
        {
            int dots = 0;
            while (!cts.Token.IsCancellationRequested)
            {
                dots = (dots % 3) + 1;
                string text = "Processing" + new string('.', dots);
                privateKey = text;
                publicKey = text;
                await InvokeAsync(StateHasChanged);
                try { await Task.Delay(500, cts.Token); }
                catch (TaskCanceledException) { break; }
            }
        });

        KeyPair? result = null;
        Exception? error = null;
        int bits = (int)keyBits;
        await Task.Run(() =>
        {
            try { result = crypto.KeyGen(bits); }
            catch (Exception x) { error = x; }
        });

        cts.Cancel();
        await animationTask;

        if (error != null)
        {
            privateKey = "";
            publicKey = "";
            ShowErrorDialogue(error.Message);
            return;
        }
        privateKey = result!.Private;
        publicKey = result!.Public;
    }

    private Task DeriveClick()
    {
        try
        {
            publicKey = crypto.DerivePublicKey(privateKey);
        }
        catch (Exception x)
        {
            ShowErrorDialogue(x.Message);
            publicKey = "";
        }
        return Task.CompletedTask;
    }

    private async Task AutofillClick()
    {
        string errorMessage = string.Empty;
        if (!Encoding.ASCII.GetString(Encoding.ASCII.GetBytes(commonName)).Equals(commonName))
        {
            IdnMapping idn = new();
            commonName = idn.GetAscii(commonName);
        }
        if (commonName.Except("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~*").Any())
        {
            errorMessage = "Common Name contains illegal characters";
        }
        else if (!IssuancePolicyService.IsValidRequestedDnsIdentity(commonName, out _))
        {
            errorMessage = "Common Name is not a valid DNS name";
        }

        if (!string.IsNullOrEmpty(errorMessage))
        {
            ShowErrorDialogue(errorMessage);
            return;
        }

        subjectAlternativeNames = commonName;

        SubjectDefaultsConfig defaults = await AccountService.GetSubjectDefaultsAsync();
        country = defaults.Country;
        stateOrProvince = defaults.StateOrProvince;
        locality = defaults.Locality;
        organisation = defaults.Organisation;
        organisationalUnit = defaults.OrganisationalUnit;
        emailAddress = defaults.EmailAddress;
    }

    private Task CSRClick()
    {
        if (string.IsNullOrEmpty(privateKey))
        {
            ShowErrorDialogue("Private key must be supplied");
            return Task.CompletedTask;
        }
        if (string.IsNullOrEmpty(publicKey))
        {
            try
            {
                publicKey = crypto.DerivePublicKey(privateKey);
            }
            catch (Exception)
            {
                ShowErrorDialogue("Public key could not be derived from private key");
                return Task.CompletedTask;
            }
        }
        KeyPair kp;
        try
        {
            kp = new KeyPair(publicKey, privateKey);
        }
        catch (ArgumentException x)
        {
            ShowErrorDialogue(x.Message);
            return Task.CompletedTask;
        }

        if (!IssuancePolicyService.IsValidRequestedDnsIdentity(commonName, out string canonicalCn))
        {
            ShowErrorDialogue("Common Name is not a valid DNS name");
            return Task.CompletedTask;
        }

        subjectAlternativeNames = string.Concat(subjectAlternativeNames.Where(c => !char.IsWhiteSpace(c)));
        List<string> sanArray = [];
        foreach (string san in subjectAlternativeNames.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            if (!IssuancePolicyService.IsValidRequestedDnsIdentity(san, out string canonicalSan))
            {
                ShowErrorDialogue("Subject Alternative Name(s) contains at least one invalid DNS name");
                return Task.CompletedTask;
            }
            sanArray.Add(canonicalSan);
        }
        if (sanArray.Count == 0)
        {
            sanArray.Add(canonicalCn);
        }

        try
        {
            _ = new RegionInfo(country.Trim());
        }
        catch (ArgumentException)
        {
            ShowErrorDialogue("Country must be a valid ISO 3166 country code");
            return Task.CompletedTask;
        }

        if (!string.IsNullOrWhiteSpace(emailAddress) && !DomainPolicyEvaluator.IsValidEmail(emailAddress))
        {
            ShowErrorDialogue("The value provided for Email Address could not be validated");
            return Task.CompletedTask;
        }
        if (string.IsNullOrEmpty(stateOrProvince))
        {
            ShowErrorDialogue("State or Province field must be present");
            return Task.CompletedTask;
        }
        if (string.IsNullOrEmpty(locality))
        {
            ShowErrorDialogue("Locality field must be present");
            return Task.CompletedTask;
        }
        if (string.IsNullOrEmpty(organisation))
        {
            ShowErrorDialogue("Organisation field must be present");
            return Task.CompletedTask;
        }

        try
        {
            csr = crypto.CSRGen(
                kp,
                canonicalCn,
                sanArray.ToArray(),
                country.Trim().ToUpperInvariant(),
                stateOrProvince.Trim(),
                locality.Trim(),
                organisation.Trim(),
                organisationalUnit.Trim(),
                emailAddress.Trim());
        }
        catch (Exception x)
        {
            ShowErrorDialogue(x.Message);
        }
        return Task.CompletedTask;
    }

    private async Task RequestClick()
    {
        if (string.IsNullOrEmpty(csr))
        {
            ShowErrorDialogue("You must provide a CSR before requesting a certificate");
            return;
        }

        AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal principal = authState.User;
        string? userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);
        string? securityStamp = principal.FindFirstValue("AspNet.Identity.SecurityStamp");

        using CancellationTokenSource cts = new();
        Task animationTask = Task.Run(async () =>
        {
            int dots = 0;
            while (!cts.Token.IsCancellationRequested)
            {
                dots = (dots % 3) + 1;
                certificate = "Processing" + new string('.', dots);
                await InvokeAsync(StateHasChanged);
                try { await Task.Delay(500, cts.Token); }
                catch (TaskCanceledException) { break; }
            }
        });

        IssuanceOutcome outcome = await CaService.IssueCertificateFromCsrAsync(
            userId,
            csr,
            explicitProfileId: null,
            requestedValidityDays: null,
            expectedSecurityStamp: securityStamp);

        cts.Cancel();
        await animationTask;

        if (!outcome.Succeeded)
        {
            certificate = "";
            ShowErrorDialogue(outcome.ErrorMessage ?? "Certificate issuance failed.");
            return;
        }

        certificate = outcome.CertificatePem ?? "";
        lastIssuedChainPem = outcome.Record?.ChainPem;
    }

    private async Task ExportClick()
    {
        if (string.IsNullOrEmpty(certificate))
        {
            ShowErrorDialogue("A certificate is required for export");
            return;
        }
        try
        {
            string? chainPem = await CaService.ResolveCertificateChainPemAsync(certificate, lastIssuedChainPem);

            Tuple<string, byte[]>? zipObj = PkcsBuilder.Export(
                certificate,
                privateKey,
                rootCaCertPath: null,
                chainPemContent: chainPem);

            if (zipObj == null)
            {
                throw new InvalidOperationException("Unable to export. Either the certificate supplied could not be parsed, or CertRobo was unable to load the CA certificate chain.");
            }

            MemoryStream output = new(zipObj.Item2);
            using DotNetStreamReference streamRef = new(output, false);
            await JS.InvokeVoidAsync("downloadFileFromStream", zipObj.Item1, streamRef);

            // Clear ephemeral generated private key from component state after export
            privateKey = "";
        }
        catch (Exception x)
        {
            ShowErrorDialogue(x.Message);
        }
    }
}
